    {
      "title": {"text": "灵魂拷问：浏览器里的 JS，为什么能碰文件、数据库和网络？", "size": 28, "align": "left"},
      "subtitle": {"text": "先看对比：浏览器沙箱 vs Node.js 操作系统绑定", "size": 15},
      "bg": {"type": "solid", "color": "F7F9FC"},
      "transition": {"type": "wipe", "dir": "l"},
      "animations": [
        {"target": 0, "effect": "appear", "trigger": "click"},
