         "paragraphs": [
           {"text": "版本治理要点", "size": 18, "bold": true, "color": "1F4E79", "spaceAfter": 8},
           {"text": "• 版本号 → CI/CD 流水线的触发信号", "size": 15, "color": "444444", "spaceAfter": 8},
           {"text": "• 严格区分 alpha / rc / latest", "size": 15, "color": "444444", "spaceAfter": 8},
           {"text": "• pnpm overrides + catalog 锁定依赖树", "size": 15, "color": "444444", "spaceAfter": 8},
           {"text": "• 环境信息用变量注入，不硬编码", "size": 15, "color": "444444"}
